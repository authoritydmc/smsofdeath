<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#D11854"
                android:endColor="#80062E"
                android:angle="45" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="#FF7597" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF2A6D"
                android:endColor="#9E0038"
                android:angle="45" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="#FF7597" />
        </shape>
    </item>
</selector>
